# Aquaman environment configuration
# Copy to .env and adjust. NEVER commit a real .env — keys stay local.

# Timezone for ALL "today"/"midnight" logic (dashboard due, ICS days, AI limits)
AQUAMAN_TIMEZONE=Europe/Berlin

# Language of a FRESH install: en | de. Only a bootstrap — once set under
# More → Language, the stored setting wins and this is ignored.
AQUAMAN_LOCALE=en

# --- AI (optional — the app works fully without a key) ---
# Anthropic-compatible endpoint. Two working configurations:
#   z.ai GLM:   https://api.z.ai/api/anthropic  + model glm-4.6
#   Anthropic:  https://api.anthropic.com       + model claude-sonnet-4-5
AQUAMAN_AI_BASE_URL=
AQUAMAN_AI_API_KEY=
AQUAMAN_AI_MODEL=

# Two-tier cost ceiling (per local day)
AQUAMAN_AI_MAX_CALLS_PER_DAY=20
AQUAMAN_AI_MAX_TOKENS_PER_DAY=200000
